# Backend environment (optional)
ENV=development
HOST=127.0.0.1
PORT=8000

# Production: set API_KEY to require X-API-Key header
# API_KEY=

# Disable raw file download in production (default: false)
ALLOW_RAW_FILE_DOWNLOAD=false

# CORS origins (JSON array)
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
