{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Insecure publicly accessible RDS database.",
  "Resources": {
    "PublicDatabase": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "DBInstanceIdentifier": "public-db-cfn-insecure",
        "Engine": "postgres",
        "PubliclyAccessible": true,
        "StorageEncrypted": false,
        "BackupRetentionPeriod": 0
      }
    }
  }
}
